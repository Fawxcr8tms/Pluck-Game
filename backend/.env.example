PORT=8080
# YouTube Data API v3 key (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=
# Firebase Admin. Leave empty on GCP (uses Application Default Credentials).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# Local development only: skips Firebase ID-token checks and uses uid "dev-user".
DEV_NO_AUTH=false
# Optional: a remote JSON file that overrides src/extractors/selectors.json without a redeploy.
SELECTORS_URL=
